# Copy this file to .env to change any of the values below, then run
# `docker compose up -d --build`. Compose picks the file up automatically.
#
# config/config.php already defaults to the same database values, so only
# change something here if you change it there too. The Node API reads the same
# file, so nothing has to be configured twice.

# Host ports. XAMPP holds 80 and 3306, so nothing here uses those.
APP_PORT=8085
PMA_PORT=8086
DB_PORT=3307

# The Node/Express service. 8087 is a third port, still clear of XAMPP.
API_PORT=8087

# The database and the ordinary application account, created on first start.
DB_NAME=morrow_and_blade_php
DB_USER=salon
DB_PASS=salon

# Password for the database root account. Administration only - the site
# itself never uses it.
DB_ROOT_PASSWORD=root

# Signs the API's bearer tokens. Change this to any long random string before
# the site goes live; if it is left alone the API warns on start-up.
JWT_SECRET=change-me-before-you-deploy
JWT_TTL=2h

# Comma separated list of origins allowed to call the API from a browser.
# Leave empty to allow any origin, which is what running the PHP site on
# http://localhost:8085 alongside the API needs.
CORS_ORIGINS=